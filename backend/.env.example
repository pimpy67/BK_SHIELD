# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_FILE=./data/licenses.sqlite

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=3600

# Crittografia
LICENSE_KEY_HMAC_SECRET=cambia_questo_segreto_con_stringa_random_lunga
OFFLINE_TOKEN_AES_KEY=cambia_con_32_byte_in_hex_o_base64
BCRYPT_ROUNDS=12

# OTP
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=30

# Rate limiting
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_RESEND_OTP_PER_HOUR=3
RATE_LIMIT_VENDOR_LOGIN_PER_HOUR=10

# VIES (validazione P.IVA EU)
VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/services/checkVatService
VIES_TIMEOUT_MS=5000

# Email
EMAIL_FROM="Servizio Licenze <noreply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Job schedulati
DEFAULT_CHECK_INTERVAL_HOURS=24
